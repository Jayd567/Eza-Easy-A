# Grab every coin before the slime catches you.  Run with:  eza examples/maze_chase.eza
# Arrows or WASD move.
# Shows: sprite animations, pathfinding (find_path), `on ... touches`, `spawn ... into`, and events.

hero_sheet = load "assets/hero_sheet.png"

# gravity=0: a top-down game, nothing falls
stage name="maze" gravity=0
    tilemap name="walls" tiles="assets/tilesheet.png" layout="maps/maze.txt" tile_size=32 position=-320,240
    sprite name="hero" texture=hero_sheet frame_size=32,32 width=24 height=24 position=-272,192 physics=true animations={idle: [0], walk: [1, 2, 0]} animation="idle" fps=10
    sprite name="slime" texture="assets/slime.png" width=24 height=24 position=272,-192

status = "Coins left: 5"
gui window "hud" x=16 y=16 width=400 background=#00000088 rounded=8 padding=10
    text "{status}" font_size=22

prefab Coin
    sprite width=12 height=12 color=#FFD54F

# every coin goes into this list; destroying one takes it out again
coins = []
each spot in [[16, 192], [-208, 0], [144, -64], [-272, -192], [272, 64]]
    spawn Coin at spot into coins

change stage.camera.zoom to 1.3
speed = 150
playing = true
route = []
timer = 0

on every frame
    if not playing
        change hero.velocity to [0, 0]
        return
    # walking
    dx = 0
    dy = 0
    if keyboard.held("a") or keyboard.held("left")
        change dx to -1
    if keyboard.held("d") or keyboard.held("right")
        change dx to 1
    if keyboard.held("w") or keyboard.held("up")
        change dy to 1
    if keyboard.held("s") or keyboard.held("down")
        change dy to -1
    change hero.velocity to [dx * speed, dy * speed]
    if dx != 0 or dy != 0
        change hero.animation to "walk"
        if dx != 0
            change hero.flip_x to dx < 0
    else
        change hero.animation to "idle"

    # the slime works out the way to the hero twice a second, then follows it point by point
    change timer by 1
    if timer % 30 == 1
        found = walls.find_path(slime.position, hero.position)
        if found != none
            change route to found
    if len(route) > 0
        change slime.position to slime.position.move_toward(route[0], 1.6)
        if distance(slime.position, route[0]) < 0.5
            route.remove(route[0])

on hero touches Coin as h, coin
    destroy coin
    change status to "Coins left: {len(coins)}"
    if len(coins) == 0
        trigger "won"

on hero touches slime
    if playing
        trigger "caught"

on event "won"
    change playing to false
    change status to "You got them all!"
    change slime.color to #80D8FF

on event "caught"
    change playing to false
    change status to "Caught! Coins left: {len(coins)}"
    change hero.color to #FF8A80
