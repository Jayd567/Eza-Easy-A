# Variables, change, if/else, each, string methods
fruits = ["apple", "banana", "kiwi", "pomegranate", "fig"]

print("uppercase fruits:")
each fruit in fruits then
    change fruit to fruit.upper
    print(fruit)

dog = "rex"
cat = "tom"
if dog == cat then
    print("woah those are the same")
else
    print("alright it's fine now thanks")

score = 10
change score by 10
change score by -5
print("score:", score)
print("the list itself changed too:", fruits)

# objects inside a list can be changed through the loop as well
data Dot
    x = 0
dots = [Dot(), Dot(x=5)]
each d in dots then
    change d.x by 1
print("dots:", dots[0].x, dots[1].x)

name = "  eza language  "
print(name.trim.capitalize, "|", name.trimleft, "|", name.length)
print("a,b,c".split(","), "hello".reverse, "ha".repeat(3), "eza".contains("z"))
print("I like cats".replace("cats", "dogs"))

n = -7.6
print(n.abs, n.floor, n.ceil, n.round, (16).sqrt, (2).pow(10), (150).clamp(0, 100), (3).min(1), (3).max(9))

nums = [5, 3, 9, 1]
print(nums.sort, nums.sum, nums.min, nums.max, nums.first, nums.last, nums.reverse, nums.contains(9))
print(fruits.sortBy(len))

red = #FF0000
print(red.r, red.hex, red.lighten(0.5), red.darken(0.5), red.mix(#0000FF, 0.5), red.invert, #808080.saturate(0.5))
